{
  "family": "operating-cash-balance-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "operating-cash-balance",
      "image": "811783767965.dkr.ecr.eu-west-1.amazonaws.com/summer26-pipeline:latest",
      "essential": true,
      "command": [
        "python",
        "src/fiscal_data/operating_cash_balance.py"
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/operating-cash-balance",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::811783767965:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::811783767965:role/ecsTaskRole"
}